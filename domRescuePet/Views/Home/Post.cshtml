@model domRescuePet.Models.Pet
@{
    ViewBag.Title = "Post a Pet";
}

<h1 class="accent">Post a Pet</h1>

@using (Html.BeginForm("Post", "Home", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div class="row">
        <!-- user details -->
        <div class="col-md-3">
            <h3 class="section-label">Your Details</h3>
            <div class="mb-2">
                <label for="PosterUserId">Select User</label>
                @Html.DropDownListFor(m => m.PosterUserId, (SelectList)ViewBag.Users, "Select User", new { @class = "form-control form-control-sm", id = "adopterUserId" })
            </div>
            <div class="mb-2">
                <label for="posterPhoneId">Select Phone</label>
                <select id="adopterPhoneId" name="posterPhoneId" class="form-control form-control-sm">
                    <option value="">Select Phone</option>
                </select>
            </div>
        </div>

        <!-- pet details -->
        <div class="col-md-3">
            <h3 class="section-label">Pet Details</h3>
            <div class="mb-2">
                <label for="PetName">Pet Name</label>
                @Html.TextBoxFor(m => m.PetName, new { @class = "form-control form-control-sm" })
            </div>
            <div class="mb-2">
                <label for="TypeId">Type</label>
                @Html.DropDownListFor(m => m.TypeId, (SelectList)ViewBag.Types, "Select Type", new { @class = "form-control form-control-sm", id = "TypeId" })
            </div>
            <div class="mb-2">
                <label for="BreedId">Breed</label>
                @Html.DropDownListFor(m => m.BreedId, (SelectList)ViewBag.Breeds, "Select Breed", new { @class = "form-control form-control-sm", id = "BreedId" })
            </div>
            <div class="mb-2">
                <label for="LocationId">Location</label>
                @Html.DropDownListFor(m => m.LocationId, (SelectList)ViewBag.Locations, "Select Location", new { @class = "form-control form-control-sm" })
            </div>
            <div class="mb-2">
                <label for="Age">Age (years)</label>
                @Html.TextBoxFor(m => m.Age, new { @class = "form-control form-control-sm", type = "number" })
            </div>
            <div class="mb-2">
                <label for="Weight">Weight (kg)</label>
                @Html.TextBoxFor(m => m.Weight, new { @class = "form-control form-control-sm", type = "number", step = "0.1" })
            </div>
            <div class="mb-2">
                <label for="Gender">Gender</label>
                @Html.DropDownListFor(m => m.Gender, (SelectList)ViewBag.Genders, "Select Gender", new { @class = "form-control form-control-sm" })
            </div>
        </div>

        <!-- pet story -->
        <div class="col-md-3">
            <h3 class="section-label">Pet Story</h3>
            <div class="mb-2">
                <label for="PetStory_Short">Short Story</label>
                @Html.TextAreaFor(m => m.PetStory_Short, new { @class = "form-control form-control-sm", rows = 3 })
            </div>
            <div class="mb-2">
                <label for="PetStory_Long">Long Story</label>
                @Html.TextAreaFor(m => m.PetStory_Long, new { @class = "form-control form-control-sm", rows = 6 })
            </div>
        </div>

        <!-- image -->
        <div class="col-md-3">
            <h3 class="section-label">Image Upload</h3>
            <div class="image-upload-placeholder mb-2">
                <img id="imagePreview" src="~/Content/Images/placeholder.png" alt="Image Preview" class="img-fluid" style="max-height:200px;" />
            </div>
            <input type="file" name="uploadImage" id="uploadImage" class="form-control form-control-sm" accept="image/*" />
        </div>
    </div>

    <!-- submit button -->
    <div class="mt-3 text-end">
        <button type="submit" class="btn btn-outline-adopt btn-lg px-4">Post Pet</button>
    </div>
}

@section Scripts {
    <script>
        /* breed + user phone number filter */
        $(document).ready(function () {

        const allBreeds = @Html.Raw(ViewBag.BreedsJson);
        const allPhones = @Html.Raw(ViewBag.PhonesJson);

        /* populate breed filter = only if type selected + breed according to type */
        $("#TypeId").change(function () {
            const typeId = parseInt($(this).val());
            const breedDropdown = $("#BreedId");
            breedDropdown.empty().append('<option value="">Select Breed</option>');
            const filtered = allBreeds.filter(b => typeId === 0 || b.TypeId === typeId);
            filtered.forEach(b => {
                breedDropdown.append(`<option value="${b.BreedId}">${b.BreedName}</option>`);
            });
            breedDropdown.prop("disabled", typeId === 0);
        });

        /* populate user phone number filter = number according to user */
        $("#adopterUserId").change(function () {
            const userId = parseInt($(this).val());
            $.getJSON('/Home/GetPhonesByUser', { userId: userId }, function (phones) {
                const phoneDropdown = $("#adopterPhoneId");
                phoneDropdown.empty().append('<option value="">Select Phone</option>');
                phones.forEach(p => {
                    phoneDropdown.append(`<option value="${p.PhoneId}">${p.PhoneNumber}</option>`);
                });
            });
        });
        });

        /* display selected image file within preview container  */
        $("#uploadImage").change(function (event) {
            const input = event.target;
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    $("#imagePreview").attr("src", e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            } else {
                $("#imagePreview").attr("src", "~/Content/Images/placeholder.png");
            }
        });
    </script>
}